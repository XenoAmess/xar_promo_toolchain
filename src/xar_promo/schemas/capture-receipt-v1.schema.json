{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xar-promo:schema:capture-receipt:v1",
  "title": "XAR promotional-video generic capture receipt v1",
  "description": "Portable, hash-bound capture timeline metadata. Semantic project policy remains outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "producer",
    "raw_capture",
    "duration_seconds",
    "timebase",
    "marks",
    "clean_spans",
    "overlap_policy"
  ],
  "properties": {
    "format_version": {"const": 1},
    "kind": {"const": "xar-promo-capture-receipt"},
    "producer": {"$ref": "#/$defs/producer"},
    "raw_capture": {"$ref": "#/$defs/file"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "timebase": {"type": "string", "minLength": 1},
    "marks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mark"}
    },
    "clean_spans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/span"}
    },
    "overlap_policy": {"enum": ["forbid", "allow"]},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "tool", "tool_version", "operation", "execution"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)(?!.*[\\u0000-\\u001f\\u007f])[^\\r\\n\\x00]+$(?![\\s\\S])"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "seconds"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "seconds": {"type": "number", "minimum": 0}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "begin_mark", "end_mark", "begin_seconds", "end_seconds", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "begin_mark": {"type": "string", "minLength": 1},
        "end_mark": {"type": "string", "minLength": 1},
        "begin_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
