{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xar-promo:schema:evidence-bundle:v2",
  "title": "XAR Promo hash-bound evidence bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "plan", "entries"],
  "properties": {
    "format_version": {"const": 2},
    "kind": {"const": "xar_promo_evidence_bundle"},
    "plan": {
      "allOf": [
        {"$ref": "#/$defs/source_record"},
        {"properties": {"role": {"const": "evidence-plan"}}}
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "collection", "role", "path", "label", "bytes", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "collection": {"enum": ["raw", "derived"]},
        "role": {"$ref": "#/$defs/id"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)(?!.*[\\u0000-\\u001f\\u007f])[^\\r\\n\\x00]+$(?![\\s\\S])"
        },
        "label": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "tool", "tool_version", "operation", "execution"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/id"},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "execution": {"const": "external"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "producer"],
      "properties": {
        "artifact": {"$ref": "#/$defs/source_record"},
        "producer": {"$ref": "#/$defs/producer"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "role", "binding"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "binding": {"$ref": "#/$defs/binding"}
      }
    }
  }
}
